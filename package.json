{
  "name": "ghostball",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/core/tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "purity": "bash scripts/purity-check.sh",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run purity && npm run build"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/three": "0.185.4",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
