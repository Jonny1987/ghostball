{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!dist", "!node_modules", "!docs"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConsole": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "three": "src/core is pure — no three.js",
                  "../scene": "src/core is pure — no scene imports",
                  "../ui": "src/core is pure — no ui imports",
                  "../debug": "src/core is pure — no debug imports"
                }
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "src/core is pure — no DOM globals",
                  "document": "src/core is pure — no DOM globals",
                  "navigator": "src/core is pure — no DOM globals",
                  "performance": "src/core is pure — no DOM globals",
                  "localStorage": "src/core is pure — no DOM globals"
                }
              }
            }
          }
        }
      }
    }
  ]
}
